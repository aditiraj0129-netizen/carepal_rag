# Copy to .env and fill in. Never commit .env. No value below is a real secret.

# --- Storage ---------------------------------------------------------------
DATA_DIR=data
SEED_DIR=seed

# --- Crawler (public pages only) -------------------------------------------
SITE_BASE_URL=https://www.thecarepal.com
CRAWL_USER_AGENT=CarePalAssistBot/0.1 (internship prototype; public pages only)
CRAWL_DELAY_SECONDS=1.0
CRAWL_RENDER_JS=false

# --- Embeddings -------------------------------------------------------------
# sentence_transformers = real multilingual model (needs: pip install -e ".[embeddings]" and HuggingFace access)
# hashing               = offline lexical fallback, NOT semantic and NOT cross-lingual
EMBED_BACKEND=sentence_transformers
EMBED_MODEL=BAAI/bge-m3

# --- LLM provider -----------------------------------------------------------
# extractive    = no LLM; answers are sentences copied from retrieved sources (works offline, zero cost)
# openai_compat = any OpenAI-compatible chat endpoint (OpenAI, Groq, Gemini's OpenAI-compatible URL, local servers)
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_MODE=hybrid
DENSE_TOP_N=20
BM25_TOP_N=20
RRF_K=60
# Optional per-list weights as JSON, e.g. {"dense_en":1.0,"dense_orig":0.5,"bm25":1.0}
RRF_WEIGHTS={}
CONTEXT_MAX_CHUNKS=5
PER_PAGE_CAP=3
GATE_TAU_DENSE=0.35
GATE_TAU_COVERAGE=0.5

# --- Security ---------------------------------------------------------------
# Admin endpoints return 503 until this is set. Generate e.g. with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=30
HANDOFF_RETENTION_DAYS=30

# --- LangSmith (optional; tracing is OFF unless both are set) ----------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=carepal-assist
